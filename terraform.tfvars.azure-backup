# Terraform configuration for Confluent Cloud Private Link with Azure Application Gateway
# Generated configuration

# Azure Infrastructure Settings
location        = "centralus"  # Confluent Cloud supports Private Link here, 32 cores available, can peer with westus2 VNet
resource_prefix = "confluent-pl"

# Create new resource group in centralus (existing RG is in westus2 with quota limits)
create_resource_group        = true
# existing_resource_group_name = "vpc-peered-cce-se"  # Commented out - using existing RG forced westus2 location

create_vnet        = true  # Create new VNet in centralus (existing VNet is in westus2)
# existing_vnet_name = "vpc-peered-cce-se-vnet"  # Commented out - in westus2
# VNet is in the same resource group, so no need to specify existing_vnet_resource_group_name

create_subnets             = true  # Create new subnets in new VNet
# existing_appgw_subnet_name = "cc-app-gateway-subnet"  # Commented out - in westus2

# VNet address space for new VNet in westus (non-overlapping with westus2 VNet 172.200.0.0/16)
vnet_address_space = ["10.100.0.0/16"]

# Subnet configuration
appgw_subnet_prefix = "10.100.9.0/24"

# IBM MQ Backend Configuration
ibm_mq_backend_targets = ["10.33.0.4"]
ibm_mq_backend_port    = 1414
ibm_mq_frontend_port   = 1414

# Application Gateway SKU
appgw_sku = {
  name     = "Standard_v2"
  tier     = "Standard_v2"
  capacity = 1
}

# Resource Tags
tags = {
  Environment = "dev"
  Purpose     = "confluent-privatelink"
  ManagedBy   = "terraform"
  owner_email = "confluent-rac-deployment@example.com"  # Required by Azure policy
}

# Confluent Cloud Configuration
confluent_cloud_api_key    = "5M6EN3WS53VPYJXH"
confluent_cloud_api_secret = "PKjaojYwhhcB7LYhY+vf9R4nsNXS4hrJGjiynGFe0P+QgHUr7NzUuo4nCnOrmE4A"
confluent_environment_id   = "t36181"
confluent_cloud_region     = "centralus"  # Must match location

# Azure Subscription ID
azure_subscription_id = "54ff81a0-e7f6-4919-9053-4cdd1c5f5ae1"

# Confluent Cloud Network Configuration
# Using existing Confluent Cloud network
create_confluent_network      = false
existing_confluent_network_id = "n-j67l8v"

# Create new Private Link Attachment
create_private_link_attachment = true

# DNS Configuration
create_dns_record = false  # Disabled temporarily - access point needs time to be ready
dns_domain        = "ibmmq2.peter.com"

# IBM MQ Source Connector Configuration
create_connector    = false  # Disabled until IBM MQ backend is ready
connector_name      = "ibm-mq-source-connector"
connector_tasks_max = 1

# Kafka Cluster Configuration
kafka_cluster_id = "lkc-gxm1kv"
kafka_api_key    = "CEXTTCEFHJN3WPVB"
kafka_api_secret = "qrEpUu1U6sP45Qa4u9CcXtBjhMI9izvguwKqeL5m7xEO6xOdTG2NVeE90oc5fYmE"
kafka_topic      = "ibm.mq2.input"

# IBM MQ Connection Settings
mq_transport     = "client"
mq_queue_manager = "QM1"
mq_channel       = "CONFLUENT.CHL"
mq_username      = "confluent"
mq_password      = "Confluent123!"

# JMS Settings
jms_destination_name = "DEV.QUEUE.1"
jms_destination_type = "queue"

# Oracle XStream CDC Connector
create_oracle_connector   = false  # Disabled until Oracle RAC is installed
oracle_connector_name     = "oracle-xstream-cdc-test"
oracle_db_user            = "C##GGADMIN"
oracle_db_password        = "Confluent12!"
oracle_table_include_list = "ORDERMGMT[.](ORDERS|CUSTOMERS|PRODUCTS)"
oracle_topic_prefix       = "oracle"
oracle_snapshot_mode      = "initial"

# ===================================================================
# Oracle RAC Configuration (2-node cluster for high availability)
# ===================================================================
provision_oracle_rac = true

# SSH Configuration
oracle_rac_ssh_public_key       = "ssh-rsa  oracle-rac-azure"
oracle_rac_ssh_private_key_path = "./ssl-certs/oracle-rac-key"

# VM Configuration (Memory optimized for Oracle - best performance)
oracle_rac_vm_size                       = "Standard_E8s_v3"  # 8 vCPU, 64 GB RAM - supports 4 NICs (need 3 for RAC) - centralus has 32 cores available
oracle_rac_os_disk_size_gb               = 64
oracle_rac_enable_accelerated_networking = false

# Network Configuration - Create new subnets in new VNet (non-overlapping with westus2)
oracle_rac_create_subnets             = true
oracle_rac_public_subnet_prefix       = "10.100.20.0/27"  # 32 IPs for client connections
oracle_rac_private_subnet_prefix      = "10.100.21.0/27"  # 32 IPs for cluster private network
oracle_rac_interconnect_subnet_prefix = "10.100.22.0/27"  # 32 IPs for Cache Fusion

# NSG Configuration
oracle_rac_create_nsg = true

# Security - No public IPs (use Bastion for access)
oracle_rac_create_public_ips           = true  # Temporarily enabled to complete RAC setup
oracle_rac_admin_source_address_prefix = "*"  # Adjust to your admin IP range if needed

# Shared Storage Configuration (Phase 2)
oracle_rac_create_shared_disks = true
oracle_rac_ocr_disk_size_gb    = 10  # OCR/Voting: 3x 10 GB (30 GB total)
oracle_rac_data_disk_size_gb   = 32  # DATA: 3x 32 GB (96 GB total for PoC database)
oracle_rac_fra_disk_size_gb    = 16  # FRA: 3x 16 GB (48 GB total for backups)
