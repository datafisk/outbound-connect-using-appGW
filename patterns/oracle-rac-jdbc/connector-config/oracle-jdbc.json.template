{
  "name": "oracle-rac-jdbc-source",
  "config": {
    "connector.class": "OracleDatabaseSource",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "<KAFKA_API_KEY>",
    "kafka.api.secret": "<KAFKA_API_SECRET>",
    "tasks.max": "1",

    "connection.host": "<EGRESS_DNS_NAME>",
    "connection.port": "1521",
    "connection.user": "jdbc_connector",
    "connection.password": "<ORACLE_PASSWORD>",
    "db.name": "xstreampdb.petertestnodes.peterglab.oraclevcn.com",
    "oracle.net.ssl_server_dn_match": "false",

    "table.include.list": "JDBC_CONNECTOR.CUSTOMERS",
    "mode": "timestamp+incrementing",
    "incrementing.column.mapping": "JDBC_CONNECTOR.CUSTOMERS:[ID]",
    "timestamp.columns.mapping": "JDBC_CONNECTOR.CUSTOMERS:[UPDATED_AT]",

    "poll.interval.ms": "5000",
    "batch.max.rows": "100",

    "topic.prefix": "oracle-rac-",
    "output.data.format": "JSON",
    "output.key.format": "JSON"
  }
}
